# =====================================================================
# server/.env.example  —  Template biến môi trường cho server
# Copy file này thành `server/.env` rồi điền giá trị thật.
# KHÔNG commit file .env (đã được .gitignore chặn).
# =====================================================================

PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database ---
DATABASE_NAME='AquaticStorePOSE'
MONGODB_URI='mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority'

# --- Auth (JWT) ---
JWT_SECRET=<chuoi-bi-mat-ngau-nhien>
JWT_LIFETIME=1d
JWT_EXPIRE=7d

# --- Redis (tuỳ chọn; không có Redis app vẫn chạy) ---
REDIS_URL=redis://localhost:6379

# --- Thanh toán: Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Thanh toán: VNPay ---
VNPAY_TMN_CODE=<tmn-code>
VNPAY_HASH_SECRET=<hash-secret>
VNPAY_HOST=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_DEBUG=true
VNPAY_SIGN_MODE=legacy
VNPAY_INCLUDE_IPN_PARAM=false
SERVER_PUBLIC_URL=http://localhost:3001

# --- Email (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER='you@gmail.com'
EMAIL_PASS='<gmail-app-password>'
EMAIL_FROM='you@gmail.com'
EMAIL_FROM_NAME='AquaticPose'

# --- Cloudinary (upload ảnh) ---
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# --- Misc ---
PROVINCES_OPEN_API=https://provinces.open-api.vn/api

# --- Google OAuth ---
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>

# =====================================================================
# AI Chat (Gemini + RAG)
# =====================================================================

# API key lấy MIỄN PHÍ tại https://aistudio.google.com/apikey (không cần thẻ).
GEMINI_API_KEY=<gemini-api-key>
PROJECT_NAME_GEMINI=projects/<project-number>
PROJECT_NUMBER_GEMINI=<project-number>

# Ghim model cố định để giá/giới hạn không thay đổi theo alias "latest".
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- RAG (tài liệu) ---
AI_ANON_QUESTION_LIMIT=4
DOC_CHUNK_SIZE=1000
DOC_CHUNK_OVERLAP=200
DOC_TOP_K=5
DOC_SCORE_THRESHOLD=0.2
DOC_MIN_TEXT_LENGTH=30
DOC_MAX_FILE_SIZE_MB=250
AI_DOC_UPLOAD_DIR=uploads/ai-docs

# --- Qdrant (vector DB; set API key nếu dùng Qdrant Cloud) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_DOCS_COLLECTION=docs_collection
QDRANT_CATALOG_COLLECTION=catalog_collection

# --- Đồng bộ catalog ---
# Sync đã là incremental (chỉ embed item thay đổi) nên interval chỉ là lưới an toàn.
CATALOG_TOP_K=5
CATALOG_SCORE_THRESHOLD=0.2
CATALOG_SYNC_INTERVAL_MINUTES=720
CATALOG_SYNC_DEBOUNCE_MS=30000
